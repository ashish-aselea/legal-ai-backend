                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json().data;",
                  "  if (data.token) pm.collectionVariables.set('adminToken', data.token);",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "3. List Pending Lawyers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
