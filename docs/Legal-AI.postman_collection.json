    {
      "name": "Booking (consultation)",
      "item": [
        {
          "name": "1. Check Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/lawyers/{{lawyerProfileId}}/availability?date={{booking_date}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "lawyers",
                "{{lawyerProfileId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{booking_date}}"
                }
              ]
            },
            "description": "Fixed slots for every lawyer: 10:00 AM, 11:30 AM, 2:00 PM, 4:30 PM. isAvailable=false means someone already holds that slot. Set {{booking_date}} to a future YYYY-MM-DD."
          }
        },
        {
          "name": "2. Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lawyerId\": \"{{lawyerProfileId}}\",\n  \"consultationType\": \"Chat\",\n  \"date\": \"{{booking_date}}\",\n  \"timeSlot\": \"11:30 AM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "consultationType: 'Chat' | 'Audio' | 'Video'. Booking is created with status 'pending_payment'; the lawyer must have a pricePerSession set first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json().data;",
                  "  if (data && data.booking) pm.collectionVariables.set('bookingId', data.booking.id);",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Confirm Payment (stub)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/{{bookingId}}/confirm-payment",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "confirm-payment"
              ]
            },
            "description": "Stands in for the real payment gateway callback until Razorpay (or similar) is integrated. Flips status pending_payment -> confirmed."
          }
        }
      ]
    }
