              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Deactivated areas disappear from the public list and are rejected on new lawyer signups, but existing lawyers who already had this value keep it."
          }
        },
        {
          "name": "9. List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users?role=user&isBlocked=true&search=ravi",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "user",
                  "disabled": true
                },
                {
                  "key": "isBlocked",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "ravi",
                  "disabled": true
                }
              ]
            },
            "description": "Run 'Auth - User' folder first so {{userId}} is set. Optional filters (enable as needed): role (user|lawyer|admin), isBlocked (true|false), search (name/mobile/email)."
          }
        },
        {
          "name": "10. Block User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users/{{userId}}/block",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}",
                "block"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Suspicious activity reported\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Blocks immediately — the user's existing token stops working on the very next request, and they cannot log in again until unblocked. Admin accounts cannot be blocked."
          }
        },
        {
          "name": "11. Unblock User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users/{{userId}}/unblock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "users",
                "{{userId}}",
                "unblock"
              ]
            }
          }
        }
      ]
    },
