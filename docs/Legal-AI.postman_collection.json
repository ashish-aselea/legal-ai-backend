{
  "info": {
    "name": "Legal-AI Backend",
    "description": "All Legal-AI backend APIs. Run requests top-to-bottom inside each folder — tokens/IDs are captured automatically into collection variables via the Tests tab, so you do not need to copy-paste anything manually.\n\nBefore running Admin requests: create an admin once from the terminal (no signup API for admin by design):\nnpm run create:admin -- 9000000099 \"Admin Name\"\n\nStatic OTP for every mobile number (dev only) is 123456 (see {{otp}} variable).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "otp",
      "value": "123456"
    },
    {
      "key": "user_mobile",
      "value": "9711111111"
    },
    {
      "key": "lawyer_mobile",
      "value": "9722222222"
    },
    {
      "key": "lawyer2_mobile",
      "value": "9733333333"
    },
    {
      "key": "admin_mobile",
      "value": "9000000099"
    },
    {
      "key": "registrationToken",
      "value": ""
    },
    {
      "key": "lawyerRegistrationToken",
      "value": ""
    },
    {
      "key": "lawyer2RegistrationToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "lawyerToken",
      "value": ""
    },
    {
      "key": "lawyer2Token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "lawyerProfileId",
      "value": ""
    },
    {
      "key": "lawyer2ProfileId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "booking_date",
      "value": ""
    },
    {
      "key": "practiceAreaId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(function () {",
          "  var d = new Date();",
          "  d.setDate(d.getDate() + 1);",
          "  pm.collectionVariables.set('booking_date', d.toISOString().slice(0, 10));",
          "})();"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "No auth. Confirms server is up and DB is connected."
          }
        }
      ]
    },
    {
      "name": "Auth - User (new signup)",
      "item": [
        {
          "name": "1. Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/send-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "send-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{user_mobile}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Change {{user_mobile}} to a fresh 10-digit number if you get a 409 later (number already signed up)."
          }
        },
        {
          "name": "2. Verify OTP (new user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{user_mobile}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Response field is always 'token'; tokenType tells you which kind: 'registration' (signup only) or 'access' (everything else)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json().data;",
                  "  if (data.tokenType === 'registration') pm.collectionVariables.set('registrationToken', data.token);",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Signup as User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{registrationToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/signup/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "signup",
                "user"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"email\": \"ravi.kumar@example.com\",\n  \"city\": \"Jaipur\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json().data;",
                  "  if (data.token) pm.collectionVariables.set('userToken', data.token);",
                  "  if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id);",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Get My Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "5. Send OTP (re-login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/send-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "send-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{user_mobile}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "6. Verify OTP (re-login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{user_mobile}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "isNewUser will now be false, tokenType will be 'access' directly (no registration step)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json().data;",
                  "  if (data.tokenType === 'access') pm.collectionVariables.set('userToken', data.token);",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Update My Profile (name/email/city)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar Updated\",\n  \"city\": \"Udaipur\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "All fields optional (name, email, city) — send at least one. Works for both user and lawyer roles."
          }
        },
        {
          "name": "8. Upload Profile Photo",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me/photo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me",
                "photo"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "description": "multipart/form-data, field name must be 'photo'. Click the field's value box in Postman and pick a JPG/PNG/WEBP file (max 5MB) — 'src' can't be pre-filled from a collection file. Works for both user and lawyer roles."
          }
        },
        {
          "name": "9. Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Stateless JWT: server has nothing to invalidate, so this just confirms the token is valid. Actual logout = the app deletes the token from local storage."
          }
        }
      ]
    },
