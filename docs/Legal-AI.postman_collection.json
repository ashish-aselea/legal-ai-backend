    {
      "name": "Admin",
      "item": [
        {
          "name": "1. Send OTP (admin number)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/send-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "send-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{admin_mobile}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "This mobile number must already exist as role=admin. Create it once from the terminal:\nnpm run create:admin -- 9000000099 \"Admin Name\""
          }
        },
        {
          "name": "2. Verify OTP (admin login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{admin_mobile}}\",\n  \"otp\": \"{{otp}}\"\n}",
