            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tax Law\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "New categories appear in GET /practice-areas (public) immediately — no app update needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json().data;",
                  "  if (data && data.practiceArea) pm.collectionVariables.set('practiceAreaId', data.practiceArea.id);",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Deactivate Practice Area (soft delete)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
